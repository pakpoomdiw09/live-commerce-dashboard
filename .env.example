# Copy this file to .env.local (same folder as package.json) and fill in the values.
# Rules: one KEY=value per line, no spaces around "=", no quotes, no [brackets], no trailing spaces.
# After editing, stop and restart `npm run dev` (env files are only read at startup).
#
# Supabase: Project Settings > API
# Use a plain URL such as https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# the anon key, or the publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# the service_role key, or the secret key (sb_secret_...). Server only: never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Facebook Page webhook + "เชื่อมต่อเพจด้วย Facebook")
# one Meta app for both: App settings > Basic
FB_APP_ID=
FB_APP_SECRET=
# Business-type apps: Facebook Login for Business > Configurations (permissions are picked there,
# include pages_show_list, pages_messaging, pages_read_engagement, pages_manage_metadata, pages_manage_engagement).
# Leave empty for other app types: the scope list in lib/facebook-oauth.ts is sent instead.
FB_LOGIN_CONFIG_ID=
# any string you choose; use the same value in the Meta webhook setup
FB_VERIFY_TOKEN=
# Optional, single-Page fallback only: each tenant saves its own Page Access Token in Settings.
# This token is never used for any Page other than FB_PAGE_ID.
FB_PAGE_ID=
FB_PAGE_TOKEN=
# set to a Graph API version that is currently supported
FB_GRAPH_VERSION=v24.0

# SlipOK
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# lets server-side callers use /api/slips/verify and /api/messages/send without a login
# any long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# AI Agent mode of "ผู้ช่วยตอบบทสนทนา" (Google AI Studio API key).
# Uses gemini-2.5-flash. Without a key, AI-mode chats use the configured fallback text.
# Server only: never use a NEXT_PUBLIC_ prefix for this key.
GEMINI_API_KEY=
# Optional server-side model override. Gemini 1.5 Flash/Pro have been shut down.
GEMINI_MODEL=gemini-2.5-flash

# Platform package payments (example recipient: replace before accepting real payments).
NEXT_PUBLIC_PROMPTPAY_ID="0800000000"
NEXT_PUBLIC_BANK_ACCOUNT_NO="9260337828"
BANK_ACCOUNT_NO="9260337828"
# Server-side PromptPay alias; leave blank to use NEXT_PUBLIC_PROMPTPAY_ID.
PROMPTPAY_NO=
NEXT_PUBLIC_BANK_ACCOUNT_NAME="ภาคภูมิ ศรีชมภู"
NEXT_PUBLIC_BANK_NAME="ธนาคารกรุงไทย"
# Optional SlipOK bank code for a bank not listed in lib/banks.ts.
PAYMENT_BANK_CODE=KTB

# protects /api/cron/follow-ups (payment reminders); falls back to INTERNAL_API_SECRET when empty
CRON_SECRET=

# Billing page: how shops pay for plans and top-ups (bank account / PromptPay). Shown as-is;
 not supported, keep it on one line.
BILLING_PAYMENT_INFO=
# Smart Follow-up: keep false until migrations, test Page and scheduler are verified.
SMART_FOLLOW_UP_SEND_ENABLED=false
# AI Vision: keep false until ai-vision.sql, a test Page and the worker are verified.
# Uses the existing server-only GEMINI_API_KEY / GEMINI_MODEL. No production opt-in by default.
AI_VISION_AUTOMATION_ENABLED=false
# Payment Verification Pro: additive opt-in. Keep disabled until staging verification.
PAYMENT_PRO_ENABLED=false
# Emergency stop for Pro entry points; the legacy verifier remains available.
PAYMENT_PRO_KILL_SWITCH=false
# Pro automatic customer notifications require production + this flag + tenant opt-in.
PAYMENT_PRO_SEND_ENABLED=false
# Set false to show the legacy slip overview while retaining bank security and verification.
PAYMENT_PRO_UI_ENABLED=true
# Agent Control Center: independent opt-in; keep all three off until staging verification.
AGENT_CONTROL_ENABLED=false
AGENT_CONTROL_KILL_SWITCH=false
AGENT_CONTROL_SEND_ENABLED=false
# Premium Overview: explicit opt-in, development or APP_ENV=staging only.
# Requires supabase/premium-overview.sql; leaves the existing /overview intact when false.
PREMIUM_OVERVIEW_ENABLED=false

# Private QR originals + bank account designer. Apply supabase/qr-payment-designer.sql first.
# Also requires PAYMENT_CHANNELS_ENABLED=true. Roll back UI by setting false.
QR_PAYMENT_DESIGNER_ENABLED=false
NEXT_PUBLIC_SALES_PAGE_V2_ENABLED=false
