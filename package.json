{
  "name": "chat-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate:safe": "node scripts/run-safe-db-migration.cjs",
    "db:migrate:sql": "node scripts/run-safe-db-migration.cjs --write-sql",
    "test:db-migration": "node --test --test-concurrency=1 scripts/test-safe-db-migration.cjs scripts/test-platform-migration.cjs",
    "clean:preview": "node scripts/clean-cache.cjs --dry-run",
    "clean:cache": "node scripts/clean-cache.cjs --apply",
    "format": "prettier --write \"{app,components,hooks,lib,scripts,tests}/**/*.{ts,tsx,js,cjs,mjs}\" \"*.{ts,js,cjs,mjs,json}\"",
    "format:check": "prettier --check \"{app,components,hooks,lib,scripts,tests}/**/*.{ts,tsx,js,cjs,mjs}\" \"*.{ts,js,cjs,mjs,json}\"",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint app components lib middleware.ts",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "test:performance": "node --test --test-concurrency=2 scripts/test-payment-api.cjs scripts/test-payment-checkout.cjs scripts/test-payment-pro.cjs scripts/test-payment-validation.cjs scripts/test-premium-overview.cjs scripts/test-dashboard-performance.cjs scripts/test-dashboard-read-models.cjs scripts/test-agent-overview.cjs scripts/test-dashboard-recovery.cjs scripts/test-platform-dashboard-api.cjs scripts/test-dashboard-page-scope.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@supabase/ssr": ">=0.6.1 <1",
    "@supabase/supabase-js": "^2.85.0",
    "framer-motion": "^14.2.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.0",
    "promptpay-qr": "^0.5.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "pg": "^8.23.1",
    "postcss": "^8",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
