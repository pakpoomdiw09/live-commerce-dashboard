# Copy to .env.migration.local in the project root (already ignored by Git).
# Supabase Dashboard > Connect > Direct Connection, or Session Pooler (port 5432).
# URL-encode special characters in the DATABASE password. Never use the service-role API key here.
DIRECT_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full

# Optional: trusted CA downloaded from your Supabase database connection settings.
# SAFE_MIGRATION_CA_FILE=C:/path/to/supabase-ca.crt
