+    diff += git(['diff', '--no-index', '--', 'NUL', file])
+}
+fs.writeFileSync(path.join(dir, 'changes.patch'), diff)
+fs.writeFileSync(path.join(dir, 'status.txt'), git(['status', '--short', '--', ...sourcePaths]))
+fs.writeFileSync(
