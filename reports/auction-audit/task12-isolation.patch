+// Read-only diagnostics. Never prints keys, messages, customer names or slip contents.
+const fs = require('node:fs')
+const { createClient } = require('@supabase/supabase-js')
+
+async function main() {
+  if (fs.existsSync('.env.local')) process.loadEnvFile('.env.local')
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL || process.env.SUPABASE_URL
+  const key = process.env.SUPABASE_SERVICE_ROLE_KEY
+  if (!url || !key) throw Error('Missing Supabase URL or service-role key')
+  const redact = (value) =>
+    String(value ?? '')
+      .split(key)
+      .join('[REDACTED]')
+  const db = createClient(url, key, {
+    auth: { persistSession: false, autoRefreshToken: false },
+    global: {
+      fetch: (input, init) => fetch(input, { ...init, signal: AbortSignal.timeout(15000) }),
+    },
+  })
+  console.log('Project:', new URL(url).hostname, '(service role; bypasses RLS)')
+  let tenant = process.argv.find((arg) => arg.startsWith('--tenant='))?.slice(9)
+  if (!tenant) {
+    const shops = await db.from('tenants').select('id').eq('is_active', true).limit(2)
+    if (shops.error) throw Error('Tenant lookup: ' + redact(shops.error.message))
+    if (
+      !shops.data?.length ||
+      (shops.data.length !== 1 && !process.argv.includes('--first-active'))
+    )
+      throw Error('Specify --tenant=<UUID> or --first-active; expected exactly one active shop')
+    tenant = shops.data[0].id
+  }
+  if (!/^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$/i.test(tenant))
+    throw Error('Invalid tenant UUID')
+  const to = new Date(),
+    bangkokDate = new Date(to.getTime() + 7 * 3600000).toISOString().slice(0, 10)
+  const from = new Date(new Date(bangkokDate + 'T00:00:00+07:00').getTime() - 29 * 86400000)
+  const previous = new Date(from.getTime() - 30 * 86400000)
+  console.log('Tenant:', tenant, 'range:', from.toISOString(), '→', to.toISOString())
+  let failures = 0
+  async function check(query, action) {
+    try {
+      const result = await action()
+      if (result.error) {
+        failures++
+        console.error(
+          JSON.stringify({
+            query,
+            status: result.status,
+            code: result.error.code,
+            message: redact(result.error.message),
+            details: redact(result.error.details),
+            hint: redact(result.error.hint),
+          }),
+        )
+        return
+      }
+      console.log(
+        JSON.stringify({
+          query,
+          status: result.status,
+          count: result.count ?? undefined,
+          found:
+            result.count !== null && result.count !== undefined
+              ? result.count > 0
+              : result.data !== null,
+          allowed: typeof result.data === 'boolean' ? result.data : undefined,
+          keys: result.data && !Array.isArray(result.data) ? Object.keys(result.data) : undefined,
+          shape:
+            query === 'overview_dashboard_stats'
+              ? {
+                  access: result.data?.access,
+                  activityArray: Array.isArray(result.data?.activity),
+                  hoursArray: Array.isArray(result.data?.hours),
+                  slipsArray: Array.isArray(result.data?.slips),
+                  chatsArray: Array.isArray(result.data?.chats),
+                  totals: result.data?.totals,
+                  messages: result.data?.messages,
+                  customers: result.data?.uniqueCustomers,
+                  activityDates: result.data?.activity?.slice(0, 2).map((point) => point.key),
+                }
+              : undefined,
+        }),
+      )
+    } catch (error) {
+      failures++
+      console.error(JSON.stringify({ query, message: redact(error.message) }))
+    }
+  }
+  await Promise.all([
+    check('tenants.active', () =>
+      db.from('tenants').select('id').eq('id', tenant).eq('is_active', true).maybeSingle(),
+    ),
+    check('tenants.credit_columns', () =>
+      db
+        .from('tenants')
+        .select('slip_quota,slip_used,slip_quota_credits')
+        .eq('id', tenant)
+        .maybeSingle(),
+    ),
+    check('customers.count', () =>
+      db.from('customers').select('id', { count: 'exact', head: true }).eq('tenant_id', tenant),
+    ),
+    check('slips.count', () =>
+      db
+        .from('slips')
+        .select('id', { count: 'exact', head: true })
+        .eq('tenant_id', tenant)
+        .gte('created_at', from.toISOString())
+        .lt('created_at', to.toISOString()),
+    ),
+    check('messages.inbound_count', () =>
+      db
+        .from('messages')
+        .select('id,customers!inner(tenant_id)', { count: 'exact', head: true })
+        .eq('customers.tenant_id', tenant)
+        .eq('sender', 'customer')
+        .gte('created_at', from.toISOString())
+        .lt('created_at', to.toISOString()),
+    ),
+    check('agent_message_jobs.count', () =>
+      db
+        .from('agent_message_jobs')
+        .select('id', { count: 'exact', head: true })
+        .eq('tenant_id', tenant),
+    ),
+    check('overview_dashboard_stats', () =>
+      db.rpc('overview_dashboard_stats', {
+        p_tenant: tenant,
+        p_from: from.toISOString(),
+        p_to: to.toISOString(),
+        p_previous: previous.toISOString(),
+        p_page: 1,
+        p_query: '',
+      }),
+    ),
+    check('has_tenant_feature.customer_management', () =>
+      db.rpc('has_tenant_feature', { p_tenant: tenant, p_feature: 'customer_management' }),
+    ),
+  ])
+  console.log(
+    'PGRST202/42883: missing RPC/signature/schema cache; 42501: permission/tenant gate; 42703: missing column; 57014: SQL timeout.',
+  )
+  console.log(
+    'Zero rows alone cannot prove RLS failure. This service-role check does not test browser-session RLS.',
+  )
+  process.exitCode = failures ? 1 : 0
+}
+main().catch((error) => {
+  console.error(error.message)
+  process.exitCode = 1
+})

diff --git a/scripts/test-network-guard.cjs b/scripts/test-network-guard.cjs
new file mode 100644
index 0000000..0ad2297
--- /dev/null
+++ b/scripts/test-network-guard.cjs
@@ -0,0 +1,171 @@
+// Loaded before automated test files. Tests may use loopback services only.
+const fs = require('node:fs')
+const http = require('node:http')
+const https = require('node:https')
+const net = require('node:net')
+const tls = require('node:tls')
+const dgram = require('node:dgram')
+const dns = require('node:dns')
+
+const BLOCKED_NETWORK_CODE = 'ERR_TEST_NETWORK_BLOCKED'
+const BLOCKED_ENV_CODE = 'ERR_TEST_ENV_FILE_ACCESS_BLOCKED'
+
+function envPath(value) {
+  if (value instanceof URL && value.protocol === 'file:') value = require('node:url').fileURLToPath(value)
+  if (typeof value !== 'string' && !Buffer.isBuffer(value)) return false
+  const name = String(value).replaceAll('\\', '/').split('/').at(-1) ?? ''
+  return /^\.env(?:\.|$)/i.test(name)
+}
+
+function assertNotEnvFile(value, operation) {
+  if (!envPath(value)) return
+  const error = new Error(`Automated tests may not access .env files (${operation})`)
+  error.code = BLOCKED_ENV_CODE
+  throw error
+}
+
+for (const method of ['readFile', 'readFileSync', 'open', 'openSync', 'createReadStream']) {
+  const original = fs[method]
+  if (typeof original !== 'function') continue
+  fs[method] = function guardedEnvRead(file, ...args) {
+    assertNotEnvFile(file, `fs.${method}`)
+    return Reflect.apply(original, this, [file, ...args])
+  }
+}
+for (const promiseFs of new Set([fs.promises, require('node:fs/promises')])) {
+  for (const method of ['readFile', 'open']) {
+    const original = promiseFs[method]
+    if (typeof original !== 'function') continue
+    promiseFs[method] = function guardedEnvPromiseRead(file, ...args) {
+      assertNotEnvFile(file, `fs.promises.${method}`)
+      return Reflect.apply(original, this, [file, ...args])
+    }
+  }
+}
+if (typeof process.loadEnvFile === 'function') {
+  process.loadEnvFile = function blockedEnvLoad(file) {
+    assertNotEnvFile(file ?? '.env', 'process.loadEnvFile')
+    const error = new Error('Automated tests may not load .env files')
+    error.code = BLOCKED_ENV_CODE
+    throw error
+  }
+}
+
+function hostFrom(value) {
+  if (value instanceof URL) return value.hostname
+  if (value && typeof value === 'object') {
+    if (value.socketPath || (value.path && !value.host && !value.hostname)) return '__local_socket__'
+    return value.hostname ?? value.host ?? value.servername ?? 'localhost'
+  }
+  if (typeof value === 'number' || value == null) return 'localhost'
+  if (typeof value !== 'string') {
+    if (typeof value.url === 'string') return hostFrom(value.url)
+    return null
+  }
+  const address = value.trim()
+  if (!address) return null
+  try {
+    return new URL(address).hostname
+  } catch {
+    if (address.startsWith('[') && address.includes(']')) return address.slice(1, address.indexOf(']'))
+    if ((address.match(/:/g) ?? []).length === 1) return address.slice(0, address.lastIndexOf(':'))
+    return address
+  }
+}
+
+function assertLocal(host, mechanism) {
+  const normalized = String(host ?? '').toLowerCase().replace(/^\[|\]$/g, '')
+  if (normalized === 'localhost' || normalized === '127.0.0.1') return
+  const error = new Error(`Blocked outbound ${mechanism} to non-localhost address: ${normalized || '(unknown)'}`)
+  error.code = BLOCKED_NETWORK_CODE
+  throw error
+}
+
+function requestTarget(input, options) {
+  let host = hostFrom(input)
+  if (options && typeof options === 'object' && (options.hostname || options.host))
+    host = options.hostname ?? options.host
+  if (input && typeof input === 'object' && input.socketPath) host = '__local_socket__'
+  if (options?.socketPath) host = '__local_socket__'
+  return host
+}
+
+for (const module of [http, https]) {
+  for (const method of ['request', 'get']) {
+    const original = module[method]
+    module[method] = function guardedHttpRequest(input, options, ...args) {
+      assertLocal(requestTarget(input, options), `${module === https ? 'https' : 'http'}.${method}`)
+      return Reflect.apply(original, this, [input, options, ...args])
+    }
+  }
+}
+
+const originalFetch = globalThis.fetch
+if (typeof originalFetch === 'function') {
+  globalThis.fetch = function guardedFetch(input, ...args) {
+    const target = input instanceof URL || typeof input === 'string' ? input : input?.url
+    assertLocal(hostFrom(target), 'fetch')
+    return Reflect.apply(originalFetch, this, [input, ...args])
+  }
+}
+
+function socketHost(args) {
+  const [target, host] = args
+  if (target && typeof target === 'object') return hostFrom(target)
+  if (typeof target === 'number') return typeof host === 'string' ? host : 'localhost'
+  if (typeof target === 'string') return '__local_socket__'
+  return 'localhost'
+}
+
+for (const method of ['connect', 'createConnection']) {
+  const original = net[method]
+  net[method] = function guardedSocket(...args) {
+    assertLocal(socketHost(args), `net.${method}`)
+    return Reflect.apply(original, this, args)
+  }
+}
+const originalSocketConnect = net.Socket.prototype.connect
+net.Socket.prototype.connect = function guardedRawSocket(...args) {
+  assertLocal(socketHost(args), 'net.Socket.connect')
+  return Reflect.apply(originalSocketConnect, this, args)
+}
+
+const originalTlsConnect = tls.connect
+tls.connect = function guardedTlsConnect(first, second, ...args) {
+  const host =
+    typeof first === 'number'
+      ? typeof second === 'string'
+        ? second
+        : second && typeof second === 'object'
+          ? hostFrom(second)
+          : 'localhost'
+      : hostFrom(first)
+  assertLocal(host, 'tls.connect')
+  return Reflect.apply(originalTlsConnect, this, [first, second, ...args])
+}
+
+const originalDgramConnect = dgram.Socket.prototype.connect
+dgram.Socket.prototype.connect = function guardedDatagramConnect(port, address, ...args) {
+  assertLocal(address, 'dgram.connect')
+  return Reflect.apply(originalDgramConnect, this, [port, address, ...args])
+}
+const originalDgramSend = dgram.Socket.prototype.send
+dgram.Socket.prototype.send = function guardedDatagramSend(...args) {
+  const address = [args[2], args[3], args[4]].find((value) => typeof value === 'string')
+  if (address) assertLocal(address, 'dgram.send')
+  return Reflect.apply(originalDgramSend, this, args)
+}
+
+function guardDnsMethod(object, method, hostIndex = 0) {
+  const original = object?.[method]
+  if (typeof original !== 'function') return
+  object[method] = function guardedDnsLookup(...args) {
+    assertLocal(hostFrom(args[hostIndex]), `dns.${method}`)
+    return Reflect.apply(original, this, args)
+  }
+}
+for (const method of ['lookup', 'lookupService', 'resolve', 'resolve4', 'resolve6', 'resolveCname', 'resolveMx', 'resolveNaptr', 'resolveNs', 'resolvePtr', 'resolveSoa', 'resolveSrv', 'resolveTxt', 'reverse']) {
+  guardDnsMethod(dns, method)
+  guardDnsMethod(dns.promises, method)
+  guardDnsMethod(dns.Resolver.prototype, method)
+}

diff --git a/tests/network-guard.test.ts b/tests/network-guard.test.ts
new file mode 100644
index 0000000..3307540
--- /dev/null
+++ b/tests/network-guard.test.ts
@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { readFileSync } from 'node:fs'
+import { request as httpRequest } from 'node:http'
+import { request as httpsRequest } from 'node:https'
+import { connect } from 'node:net'
+import { Socket as DatagramSocket } from 'node:dgram'
+import * as dns from 'node:dns'
+import * as tls from 'node:tls'
+
+test('test network guard immediately blocks external fetch, HTTP, HTTPS, and raw socket attempts', () => {
+  const blocked = (cause: unknown) =>
+    cause instanceof Error && 'code' in cause && cause.code === 'ERR_TEST_NETWORK_BLOCKED'
+
+  assert.throws(() => fetch('https://example.invalid/blocked'), blocked)
+  assert.throws(() => httpRequest({ hostname: 'example.invalid', port: 80 }), blocked)
+  assert.throws(() => httpsRequest({ hostname: 'example.invalid', port: 443 }), blocked)
+  assert.throws(() => connect({ host: 'example.invalid', port: 443 }), blocked)
+  assert.throws(() => connect({ path: 'C:\\not-a-local-network-socket' }), blocked)
+  assert.throws(() => tls.connect({ host: 'example.invalid', port: 443 }), blocked)
+  assert.throws(() => dns.lookup('example.invalid', () => undefined), blocked)
+
+  const socket = Object.create(DatagramSocket.prototype) as DatagramSocket
+  assert.throws(() => socket.connect(53, 'example.invalid'), blocked)
+  assert.throws(() => socket.send('x', 53, 'example.invalid'), blocked)
+})
+
+test('test network guard blocks test attempts to read or load .env files', () => {
+  assert.throws(() => readFileSync('.env.local'), {
+    code: 'ERR_TEST_ENV_FILE_ACCESS_BLOCKED',
+  })
+  const loadEnvFile = (process as NodeJS.Process & { loadEnvFile(path?: string): void }).loadEnvFile
+  assert.throws(() => loadEnvFile('.env.local'), {
+    code: 'ERR_TEST_ENV_FILE_ACCESS_BLOCKED',
+  })
+})