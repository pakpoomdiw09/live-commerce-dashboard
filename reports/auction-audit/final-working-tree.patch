new file mode 100644
--- /dev/null
+++ b/reports/security-audit-queries.sql
@@ -0,0 +1,77 @@
+-- Read-only Supabase security diagnostics. Every statement is SELECT-only.
+
+-- Row-level security status for auction and order-processing tables.
+with core_tables(table_name) as (
+  values
+    ('auctions'),
+    ('auction_bids'),
+    ('auction_deliveries'),
+    ('auction_poll_cursors'),
+    ('auction_winner_claims'),
+    ('customer_tabs'),
+    ('customers'),
+    ('facebook_webhook_events'),
+    ('live_sessions'),
+    ('messages'),
+    ('orders')
+)
+select
+  core_tables.table_name,
+  coalesce(c.relrowsecurity, false) as rls_enabled,
+  coalesce(c.relforcerowsecurity, false) as rls_forced,
+  c.relkind as relation_kind
+from core_tables
+left join pg_catalog.pg_class c on c.relname = core_tables.table_name
+left join pg_catalog.pg_namespace n on n.oid = c.relnamespace and n.nspname = 'public'
+where c.oid is null or n.oid is not null
+order by core_tables.table_name;
+
+-- Policies, including target roles and both policy predicates.
+select
+  schemaname,
+  tablename,
+  policyname,
+  permissive,
+  roles,
+  cmd,
+  qual,
+  with_check
+from pg_catalog.pg_policies
+where schemaname = 'public'
+  and tablename = any(array[
+    'auctions',
+    'auction_bids',
+    'auction_deliveries',
+    'auction_poll_cursors',
+    'auction_winner_claims',
+    'customer_tabs',
+    'customers',
+    'facebook_webhook_events',
+    'live_sessions',
+    'messages',
+    'orders'
+  ])
+order by tablename, policyname;
+
+-- Effective EXECUTE privileges for auction functions by API role.
+select
+  p.oid::regprocedure as function_signature,
+  has_function_privilege('anon', p.oid, 'EXECUTE') as anon_execute,
+  has_function_privilege('authenticated', p.oid, 'EXECUTE') as authenticated_execute,
+  has_function_privilege('service_role', p.oid, 'EXECUTE') as service_role_execute
+from pg_catalog.pg_proc p
+join pg_catalog.pg_namespace n on n.oid = p.pronamespace
+where n.nspname = 'public'
+  and p.proname = any(array[
+    'finalize_live_auction',
+    'finalize_live_auction_highest_bid',
+    'normalize_auction_settings_before_split',
+    'process_live_auction_comment',
+    'process_live_auction_highest_bid',
+    'advance_live_auction',
+    'expire_live_auctions',
+    'expire_live_auctions_report',
+    'close_due_live_auction',
+    'start_legacy_auction_timer'
+  ])
+order by p.proname, p.oid::regprocedure::text;
diff --git a/scripts/audit-credential-shapes.cjs b/scripts/audit-credential-shapes.cjs
new file mode 100644
--- /dev/null
+++ b/scripts/audit-credential-shapes.cjs
@@ -0,0 +1,80 @@
+const fs = require('node:fs')
+const path = require('node:path')
+const { execFileSync } = require('node:child_process')
+
+const root = process.cwd()
+const patterns = [
+  ['META_ACCESS_TOKEN', /\bEA[A-Za-z0-9]{50,}\b/g],
+  ['SUPABASE_SECRET_KEY', /\bsb_secret_[A-Za-z0-9_-]{20,}\b/g],
+  ['APP_OR_CLIENT_SECRET', /\b(?:app|client)[_-]?secret\s*[:=]\s*["']?([a-f0-9]{32})/gi],
+  [
+    'CREDENTIAL_ASSIGNMENT_LITERAL',
+    /\b(access[_-]?token|refresh[_-]?token|api[_-]?key|service[_-]?role[_-]?key|password|private[_-]?key|secret)\s*[:=]\s*(["'])([A-Za-z0-9_./+=-]{20,})\2/gi,
+  ],
+  [
+    'ENV_CREDENTIAL_ASSIGNMENT',
+    /^\s*([A-Za-z_][A-Za-z0-9_]*(?:TOKEN|SECRET|API_KEY|PASSWORD|PRIVATE_KEY))\s*=\s*([^\s#]{20,})/i,
+  ],
+]
+const findings = []
+
+function isFixture(relativePath, line) {
+  return (
+    /\/(?:tests?|fixtures?|mocks?|examples?)\//i.test(`/${relativePath}`) ||
+    /(?:^|\/)test-[^/]+\.(?:cjs|mjs|js|ts)$/i.test(relativePath) ||
+    /\.env\.example$/i.test(relativePath) ||
+    /dummy|placeholder|replace[_ -]?me|your[_ -]?(?:key|token|secret)|example[_ -]?(?:key|token|secret)/i.test(line)
+  )
+}
+
+const trackedAndUnignored = execFileSync('git', ['ls-files', '-co', '--exclude-standard'], {
+  cwd: root,
+  encoding: 'utf8',
+})
+  .split(/\r?\n/)
+  .filter(Boolean)
+const environmentFiles = fs
+  .readdirSync(root)
+  .filter((name) => name === '.env' || name.startsWith('.env.'))
+const files = new Set([...trackedAndUnignored, ...environmentFiles])
+
+for (const relativePath of files) {
+  const absolutePath = path.join(root, relativePath)
+  let content
+  try {
+    if (fs.statSync(absolutePath).size > 5_000_000) continue
+    content = fs.readFileSync(absolutePath, 'utf8')
+  } catch {
+    continue
+  }
+  const lines = content.split(/\r?\n/)
+  for (let index = 0; index < lines.length; index++) {
+    for (const [category, pattern] of patterns) {
+      if (category === 'ENV_CREDENTIAL_ASSIGNMENT' && !/^\.env(?:\.|$)/i.test(path.basename(relativePath)))
+        continue
+      pattern.lastIndex = 0
+      const match = pattern.exec(lines[index])
+      if (!match) continue
+      findings.push({
+        path: relativePath.replaceAll('\\', '/'),
+        line: index + 1,
+        category,
+        key:
+          category === 'ENV_CREDENTIAL_ASSIGNMENT'
+            ? match[1]
+            : category === 'CREDENTIAL_ASSIGNMENT_LITERAL'
+              ? match[1]
+              : undefined,
+        classification: isFixture(relativePath, lines[index])
+          ? 'fixture-or-placeholder'
+          : 'real-like-unverified',
+      })
+    }
+  }
+}
+
+console.log(`Sanitized credential-shape scan: ${findings.length} matches`)
+for (const finding of findings)
+  console.log(
+    `${finding.path}:${finding.line} ${finding.category}${finding.key ? ` key=${finding.key}` : ''} ${finding.classification} (value suppressed)`,
+  )
