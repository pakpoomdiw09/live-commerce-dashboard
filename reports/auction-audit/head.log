    -- 65. inbox-messenger-window.sql | Latest delivery safety, reporting and index patches
    -- SHA256: 4ebe59d252e016e5d62eb28617e9a08d27847550f925f0273d18cc456c43e77e
    -- ============================================================================
    begin;
    set local lock_timeout = '2s';
