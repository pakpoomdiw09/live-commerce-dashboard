     ) then raise exception 'COMMERCE_CATEGORY';end if;
     if p_id is null then
      insert into public.products(id,tenant_id,code,name,price,stock)
      values(pid,p_tenant,p_value->>'code',p_value->>'name',(p_value->>'price')::numeric,0);
