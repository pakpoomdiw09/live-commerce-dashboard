    -- billing.sql: source statement 11
    begin
    execute $sql_7_11$create or replace function reserve_broadcast_credits(p_tenant uuid, p_count integer)
    returns table (monthly integer, topup integer)
    language plpgsql as $$
    declare
      t tenants;
      m integer;
      u integer;
