    -- SHA256: e2ea4378ff467948e65ff1e8df4703c9f7c161df9a9af51e0912b39fa5e5f48a
    -- ============================================================================
    begin;
    set local lock_timeout = '2s';
    set local statement_timeout = '60s';
    set local search_path = public, extensions;
    
