     on conflict(tenant_id) do update set stopped=excluded.stopped,updated_at=now();
     insert into public.tenant_automation_audit(tenant_id,actor_id,stopped,reason) values(p_tenant,p_actor,p_stopped,trim(p_reason));
    end $$;
    
    -- Source statement 10
