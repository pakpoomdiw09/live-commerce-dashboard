    create or replace function public.default_auction_close_keywords() returns jsonb
    language sql immutable set search_path=pg_catalog,public as $$ select '["ปิด","จบ","พอ","321","3 2 1","x","X","❌","🛑","⛔","🚫","✖️","🏁","🚩","🔨","🔔","⏰","❤️","🖤"]'::jsonb $$;
    
    -- Source statement 3
    create or replace function public.auction_close_keyword_matches(message text,keywords jsonb) returns boolean
    language sql immutable set search_path=pg_catalog,public as $$
     select exists(select 1 from jsonb_array_elements_text(keywords) k
     where length(translate(trim(k),U&'\FE0E\FE0F',''))>0 and position(
      translate(lower(regexp_replace(normalize(trim(k),NFKC),'\s+',' ','g')),U&'\FE0E\FE0F','')
      in translate(lower(regexp_replace(normalize(trim(coalesce(message,'')),NFKC),'\s+',' ','g')),U&'\FE0E\FE0F',''))>0)
    $$;
    
