    -- 104. facebook-webhook-comment-ordering.sql | Latest delivery safety, reporting and index patches
    -- SHA256: 90627535bb971b3ded5588c770217d591c94ea17534afff0547ed2669fe37c69
    -- ============================================================================
    begin;
    set local lock_timeout = '2s';
