    -- 110. shipping-integrations-beemove.sql | Latest delivery safety, reporting and index patches
    -- SHA256: d9d57a631be5139cd85320e430030d3791dba88caac9d83602c939bd810a409a
    -- ============================================================================
    begin;
    set local lock_timeout = '2s';
