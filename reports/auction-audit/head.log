    -- 117. facebook-message-echoes.sql | Latest delivery safety, reporting and index patches
    -- SHA256: b5d834556f05a2e0a49ae363a7625dd26e46dd5967dbd6429c4184fd7c8ffed2
    -- ============================================================================
    begin;
    set local lock_timeout = '2s';
