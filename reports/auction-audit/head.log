      if old.status = 'cancelled' then
        raise exception 'ออเดอร์ที่ยกเลิกแล้วเปลี่ยนสถานะไม่ได้';
      end if;
      if new.status = 'cancelled' and new.product_id is not null then
        update products set stock = stock + 1 where id = new.product_id;
      end if;
      return new;
    end $$$sql_6_18$;
